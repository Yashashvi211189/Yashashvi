{
  "name": "star-wars-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A cinematic Star Wars-themed developer portfolio with 3D animations and holographic UI elements",
  "author": "Yashashvi Agnihotri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yashashvi211189/star-wars-portfolio.git"
  },
  "homepage": "https://yashashvi211189.github.io/Yashashvi/",
  "keywords": [
    "portfolio",
    "react",
    "star-wars",
    "three.js",
    "vite",
    "framer-motion",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "server": "nodemon server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "optimize-report": "node optimize-assets.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.23.24",
    "maath": "^0.10.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-responsive": "^10.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "terser": "^5.44.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.9",
    "vite-plugin-compression": "^0.5.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
